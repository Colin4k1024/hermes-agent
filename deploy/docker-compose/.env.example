# Hermes Agent Enterprise SaaS — Local Development Environment
# Copy this file to .env and fill in real values for production

# ══════════════════════════════════════════════════════════════════════
# PostgreSQL
# ══════════════════════════════════════════════════════════════════════
POSTGRES_USER=hermes
POSTGRES_PASSWORD=hermes
POSTGRES_DB=hermes_platform

# ══════════════════════════════════════════════════════════════════════
# JWT / Auth
# ══════════════════════════════════════════════════════════════════════
JWT_SECRET=dev-jwt-secret-change-in-prod
ADMIN_API_KEY=dev-admin-key-change-in-prod

# OIDC (Keycloak) — only needed when using the `with-keycloak` profile
OIDC_ISSUER=http://localhost:8880/realms/hermes
OIDC_CLIENT_ID=hermes-auth
OIDC_CLIENT_SECRET=dev-secret

# ══════════════════════════════════════════════════════════════════════
# LiteLLM Mock
# ══════════════════════════════════════════════════════════════════════
LITELLM_MASTER_KEY=sk-mock-key-change-in-prod

# ══════════════════════════════════════════════════════════════════════
# Feishu (Enterprise Bot)
# ══════════════════════════════════════════════════════════════════════
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ══════════════════════════════════════════════════════════════════════
# Hermes Agent (Dev Mode)
# ══════════════════════════════════════════════════════════════════════
HERMES_API_KEY=hermes-dev-key
STATE_INTERNAL_API_KEY=dev-state-key-change-in-prod

# Host-side UID/GID for the hermes user inside the container
# Run: id (on macOS/Linux) to find your UID/GID and fill them in
HERMES_UID=10000
HERMES_GID=10000
