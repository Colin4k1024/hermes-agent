# LiteLLM Configuration — Environment Variables
# ==============================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control!
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual API keys

# ══════════════════════════════════════════════════════════════
# API Keys (REQUIRED for production)
# ══════════════════════════════════════════════════════════════

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API Key
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google API Key
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# ══════════════════════════════════════════════════════════════
# LiteLLM Master Key (REQUIRED)
# ══════════════════════════════════════════════════════════════
# Master key for LiteLLM admin API. Set a strong random value.
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-prod-change-me

# ══════════════════════════════════════════════════════════════
# Database Configuration
# ══════════════════════════════════════════════════════════════
# PostgreSQL connection string for LiteLLM key management and token tracking
DATABASE_URL=postgresql+asyncpg://hermes:hermes@postgres:5432/hermes_platform

# ══════════════════════════════════════════════════════════════
# Redis Configuration
# ══════════════════════════════════════════════════════════════
REDIS_URL=redis://redis:6379/0

# ══════════════════════════════════════════════════════════════
# Optional: Debugging
# ══════════════════════════════════════════════════════════════
# Set to true for verbose LiteLLM logging
LITELLM_DEBUG=false
