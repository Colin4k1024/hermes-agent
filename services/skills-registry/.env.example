# Skills Registry Service — Environment Variables
# Copy to .env and customize for your environment

# Service
SKILLS_REGISTRY_HOST=0.0.0.0
SKILLS_REGISTRY_PORT=8004
SKILLS_REGISTRY_DEBUG=true

# PostgreSQL
SKILLS_REGISTRY_POSTGRES_HOST=localhost
SKILLS_REGISTRY_POSTGRES_PORT=5432
SKILLS_REGISTRY_POSTGRES_USER=hermes
SKILLS_REGISTRY_POSTGRES_PASSWORD=hermes
SKILLS_REGISTRY_POSTGRES_DB=hermes_skills

# Redis
SKILLS_REGISTRY_REDIS_HOST=localhost
SKILLS_REGISTRY_REDIS_PORT=6379
SKILLS_REGISTRY_REDIS_DB=0

# File Storage
# When DEBUG=true, uses local path; when DEBUG=false, uses NAS path
SKILLS_REGISTRY_SKILLS_STORAGE_PATH=/nas/org-skills
SKILLS_REGISTRY_SKILLS_LOCAL_DEV_PATH=./dev-skills

# Auth
SKILLS_REGISTRY_ADMIN_API_KEY=dev-admin-key-change-in-prod
