# Agent Router Service — Environment Variables

# Service
ROUTER_HOST=0.0.0.0
ROUTER_PORT=8002
ROUTER_DEBUG=false

# Redis
ROUTER_REDIS_HOST=localhost
ROUTER_REDIS_PORT=6379
ROUTER_REDIS_DB=0
ROUTER_REDIS_PASSWORD=

# Auth Service
ROUTER_AUTH_SERVICE_URL=http://localhost:8001

# Quota Service
ROUTER_QUOTA_SERVICE_URL=http://localhost:8003

# Internal API key (K8s: via Secret)
ROUTER_INTERNAL_API_KEY=dev-internal-key-change-in-prod
