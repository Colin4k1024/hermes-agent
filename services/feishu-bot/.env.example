# Feishu Bot Service — environment variables
# Copy to .env and fill in real values

# ── Feishu ────────────────────────────────────────────────────────────────────
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Internal services ──────────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://auth-service:8001
ROUTER_SERVICE_URL=http://router-service:8002

# ── Feishu Bot identity ────────────────────────────────────────────────────────
# In K8s, set via downward API: metadata.name
FBOT_INSTANCE_ID=fbp-001

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8005
LOG_LEVEL=INFO
