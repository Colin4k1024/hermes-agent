# Auth Service Environment Variables
SERVICE_PORT=8001

# JWT (change secret in production!)
JWT_SECRET_KEY=dev-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OIDC Mock (dev only)
OIDC_MOCK_ENABLED=true
OIDC_MOCK_USER_EMAIL=dev@hermes.local
OIDC_MOCK_USER_PASSWORD=devpassword
OIDC_MOCK_USER_ID=dev-user-001
OIDC_MOCK_USER_ROLE=admin

# Database
DATABASE_URL=postgresql+asyncpg://hermes:hermes@localhost:5432/hermes_auth

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8642"]
